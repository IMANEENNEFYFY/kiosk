{% extends 'base.html.twig' %}

{% block title %}Confirmation de la carte - {{ espace.nom }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .confirmation-container {
            max-width: 600px;
            margin: 50px auto;
            padding: 20px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .user-info {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        .user-info p {
            margin: 10px 0;
            font-size: 1.1em;
        }

        .btn-valider {
            background-color: var(--primary-color);
            color: white;
            padding: 12px 30px;
            border-radius: 25px;
            font-size: 1.1em;
            transition: all 0.3s ease;
        }

        .btn-valider:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
        }

        .solde {
            font-size: 1.3em;
            color: var(--primary-color);
            font-weight: bold;
        }
    </style>
{% endblock %}

{% block body %}
<div class="confirmation-container">
    <h1 class="text-center mb-4">Confirmation de la carte</h1>
    
    <div class="user-info">
        <p><strong>Nom :</strong> {{ nom }}</p>
        <p><strong>Prénom :</strong> {{ prenom }}</p>
        <p><strong>Solde :</strong> <span class="solde">{{ solde|number_format(2) }} €</span></p>
    </div>

    <div class="text-center">
        <form action="{{ path('app_valider_carte') }}" method="POST">
            <button type="submit" class="btn btn-valider">
                <i class="fas fa-check-circle me-2"></i>Valider et continuer
            </button>
        </form>
    </div>
</div>
{% endblock %} 