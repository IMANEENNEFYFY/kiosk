{% extends 'base.html.twig' %}

{% block title %}Confirmation de la carte{% endblock %}

{% block head %}
    <style>
        /* Style personnalisé pour le thème marron beige */
        body {
            background-color: #f5f5f0; /* Beige clair */
            color: #3e2a47; /* Marron foncé */
        }

        .card {
            background-color: #d8c2a6; /* Marron beige pour la carte */
            border: 1px solid #b29b7d; /* Bordure marron doux */
        }

        .card-header {
            background-color: #b29b7d; /* Tête de la carte en marron plus foncé */
            color: white;
        }

        .btn-success {
            background-color: #3e2a47; /* Boutons en marron foncé */
            border-color: #3e2a47;
        }

        .btn-success:hover {
            background-color: #4e3b55; /* Hover du bouton en marron plus foncé */
        }

        a.btn-link {
            color: #3e2a47; /* Liens en marron foncé */
        }

        a.btn-link:hover {
            color: #4e3b55; /* Hover des liens */
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header text-center">
                    <h4 class="mb-0">Carte validée avec succès</h4>
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title mb-4">Informations de la carte</h5>
                    
                    <div class="mb-3">
                        <p class="mb-1"><strong>Nom :</strong> {{ nom }}</p>
                        <p class="mb-1"><strong>Prénom :</strong> {{ prenom }}</p>
                        <p class="mb-3"><strong>Solde disponible :</strong> {{ solde }} €</p>
                    </div>

                    <form action="{{ path('app_valider_carte') }}" method="POST" class="mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            Valider la carte
                        </button>
                    </form>

                    <a href="{{ path('app_scan_carte') }}" class="btn btn-link mt-3">
                        Annuler et scanner une autre carte
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
