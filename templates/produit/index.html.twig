{# templates/produit/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Produits - {{ espace.nom }}{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background-color: #f5f5dc; /* beige */
        }

        .card {
            background-color: #fff8f0; /* beige très clair */
            border: 1px solid #d2b48c; /* brun sable */
        }

        .card-title, .card-text, .h4,
        h1, h3, .alert-info {
            color: #5d4037; /* marron foncé */
        }

        .btn-primary {
            background-color: #8b5e3c; /* marron clair */
            border-color: #8b5e3c;
        }

        .btn-primary:hover {
            background-color: #a47148; /* marron plus clair */
            border-color: #a47148;
        }

        .alert-info {
            background-color: #faebd7; /* beige rosé */
        }

        a {
            color: #8b5e3c;
            text-decoration: none;
        }

        a:hover {
            color: #a47148;
            text-decoration: underline;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold">{{ categorie.nom }} <small class="text-muted">({{ espace.nom }})</small></h1>
            <a href="{{ path('afficher_panier') }}" class="btn btn-primary btn-lg">Voir Panier</a>
        </div>

        <div class="row">
            {% for produit in produits %}
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}">
                        {% endif %}
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="card-text">{{ produit.description|default('') }}</p>
                            <p class="h4 text-success">{{ produit.prix }} €</p>
                            <form action="{{ path('ajouter_au_panier', {id: produit.id}) }}" method="POST">
                                <button type="submit" class="btn btn-primary mt-2 w-100">Ajouter au panier</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">
                        Aucun produit disponible dans cette catégorie.
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if categories|length > 1 %}
            <div class="mt-5">
                <h3>Autres catégories</h3>
                <ul class="list-unstyled row">
                    {% for cat in categories %}
                        {% if cat.id != categorie.id %}
                            <li class="col-sm-6 col-md-4 mb-2">
                                <a href="{{ path('app_produits_par_categorie', {id: cat.id}) }}">
                                    <i class="fas fa-tag me-1"></i>
                                    {{ cat.nom }} ({{ cat.produits|filter(p => p.estDisponible)|length }} dispo)
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
{% endblock %}
