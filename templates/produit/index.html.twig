{# templates/produit/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Produits - {{ espace.nom }}{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background-color: #f5ecd7; /* beige doux */
        }

        .card {
            background-color: #fff8f0; /* beige très clair */
            border: 1px solid #bfa074; /* marron/beige */
            box-shadow: 0 2px 8px #e2c9a0;
        }

        .card-title, .card-text, .h4,
        h1, h3, .alert-info {
            color: #5d4037; /* marron foncé */
        }

        .btn-primary, .btn-panier {
            background-color: #a97c50; /* marron/beige */
            border-color: #a97c50;
            color: #fffbe6;
        }
        .btn-primary:hover, .btn-panier:hover {
            background-color: #8b6842;
            border-color: #8b6842;
            color: #fff;
        }

        .btn-chariot {
            background-color: #a97c50; /* marron/beige */
            color: #fffbe6;
            border: none;
            border-radius: 25px;
            padding: 12px 18px;
            font-size: 1.5rem;
            transition: background 0.2s;
        }
        .btn-chariot:hover {
            background-color: #8b6842;
            color: #fff;
        }

        /* ✅ Styliser les icônes dans les boutons */
        .btn-panier i, .btn-chariot i {
            color: #fffbe6; /* beige clair */
            font-size: 1.5rem;
            transition: color 0.2s;
        }
        .btn-panier:hover i, .btn-chariot:hover i {
            color: #fff;
        }

        .alert-info {
            background-color: #faebd7; /* beige rosé */
            color: #5d4037;
        }

        a {
            color: #8b5e3c;
            text-decoration: none;
        }
        a:hover {
            color: #a47148;
            text-decoration: underline;
        }

        .fw-bold, h1, h3 {
            color: #7c4a02;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold">{{ categorie.nom }} <small class="text-muted">({{ espace.nom }})</small></h1>
            <!-- Bouton Voir Panier avec icône de chariot -->
            <a href="{{ path('afficher_panier') }}" class="btn btn-panier btn-lg">
                <i class="fas fa-shopping-cart me-2"></i> Voir Panier
            </a>
        </div>

        <div class="row">
            {% for produit in produits %}
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" class="card-img-top" alt="{{ produit.nom }}">
                        {% endif %}
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title">{{ produit.nom }}</h5>
                            <p class="card-text">{{ produit.description|default('') }}</p>
                            <p class="h4 text-success">{{ produit.prix }} €</p>
                            <form action="{{ path('ajouter_au_panier', {id: produit.id}) }}" method="POST">
                                <button type="submit" class="btn btn-chariot mt-2 w-100">
                                    <i class="fas fa-shopping-cart"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        Aucun produit disponible dans cette catégorie.
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if categories|length > 1 %}
            <div class="mt-5">
                <h3>Autres catégories</h3>
                <ul class="list-unstyled row">
                    {% for cat in categories %}
                        {% if cat.id != categorie.id %}
                            <li class="col-sm-6 col-md-4 mb-2">
                                <a href="{{ path('app_produits_par_categorie', {id: cat.id}) }}">
                                    <i class="fas fa-tag me-1"></i>
                                    {{ cat.nom }} ({{ cat.produits|filter(p => p.estDisponible)|length }} dispo)
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    </div>
{% endblock %}
