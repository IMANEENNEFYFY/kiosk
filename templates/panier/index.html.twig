<h1>Mon Panier</h1>

{% if panier is empty %}
    <p>Votre panier est vide.</p>
{% else %}
    <table style="margin-bottom: 20px; width: 100%; border-collapse: collapse;">
        <thead>
            <tr>
                <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Produit</th>
                <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Quantité</th>
                <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Prix unitaire</th>
                <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Total</th>
                <th style="text-align: left; padding: 8px; border-bottom: 1px solid #ddd;">Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for item in panier %}
                <tr>
                    <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ item.produit.nom }}</td>
                    <td style="padding: 8px; border-bottom: 1px solid #ddd;">
                        <span style="margin: 0 5px;">{{ item.quantite }}</span>
                        <a href="{{ path('panier_diminuer', {'id': item.produit.id}) }}" style="margin-right: 5px; text-decoration: none;">-</a>
                        <a href="{{ path('panier_ajouter', {'id': item.produit.id}) }}" style="text-decoration: none;">+</a>
                    </td>
                    <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ item.produit.prix|number_format(2, ',', ' ') }} €</td>
                    <td style="padding: 8px; border-bottom: 1px solid #ddd;">{{ (item.produit.prix * item.quantite)|number_format(2, ',', ' ') }} €</td>
                    <td style="padding: 8px; border-bottom: 1px solid #ddd;">
                        <a href="{{ path('panier_supprimer', {'id': item.produit.id}) }}" style="color: #dc3545; text-decoration: none;">×</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <h3 style="margin: 20px 0;">Total : {{ total|number_format(2, ',', ' ') }} €</h3>

    <div style="display: flex; justify-content: space-between; margin-top: 30px;">
        <a href="{{ path('app_categories') }}" style="padding: 8px 16px; background-color: #f8f9fa; color: #0d6efd; text-decoration: none; border: 1px solid #dee2e6; border-radius: 4px;">
            ← Continuer mes achats
        </a>
        
        <form action="{{ path('valider_commande') }}" method="post">
            <button type="submit" style="padding: 8px 16px; background-color: #198754; color: white; border: none; border-radius: 4px; cursor: pointer;">
                Valider la commande
            </button>
        </form>
    </div>
{% endif %}