<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Ticket #{{ commande.id }}</title>
    <style>
        body { 
            font-family: 'Courier New', monospace;
            width: 80mm;
            margin: 0 auto;
            padding: 10px;
            font-size: 14px;
        }
        .header, .footer {
            text-align: center;
            margin: 10px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th { text-align: left; }
        .total { font-weight: bold; border-top: 1px dashed #000; }
        .barcode-container {
            text-align: center;
            margin: 20px 0;
        }
        .barcode-container svg {
            height: 60px;
            width: 100%;
        }
        .barcode-text {
            font-family: 'Courier New', monospace;
            font-size: 14px;
            margin-top: 5px;
        }
    </style>
</head>
<body>
    <div class="header">
        <h3>MON RESTAURANT</h3>
        <p>Ticket #{{ commande.id }}</p>
        <p>{{ commande.date|date('d/m/Y H:i') }}</p>
    </div>

    <table>
        <thead>
            <tr>
                <th>Article</th>
                <th>Qte</th>
                <th>Prix</th>
            </tr>
        </thead>
        <tbody>
            {% for element in commande.elements %}
            <tr>
                <td>{{ element.produit.nom }}</td>
                <td>{{ element.quantite }}</td>
                <td>{{ (element.prixUnitaire * element.quantite)|format_currency('EUR') }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <p class="total">Total: {{ commande.total|format_currency('EUR') }}</p>

    <div class="barcode-container">
        {{ barcode_svg|raw }}
        <div class="barcode-text">CMD-{{ commande.id }}</div>
    </div>

    <div class="footer">
        Merci pour votre commande !
    </div>
</body>
</html>