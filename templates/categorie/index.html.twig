{% extends 'base.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .categories-container {
      padding: 3rem 0;
    }
    
    .category-card {
      border: none;
      border-radius: 15px;
      overflow: hidden;
      background: white;
      transition: all 0.3s ease;
      height: 100%;
      display: flex;
      flex-direction: column;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    
    .category-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }
    
    .category-img-container {
      height: 200px;
      background-color: #f8f9fa;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: hidden;
    }
    
    .category-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    
    .category-img-container:hover .category-img {
      transform: scale(1.05);
    }
    
    .category-body {
      padding: 1.5rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    
    .btn-category {
      align-self: center;
      margin-top: auto;
      background: var(--primary-color);
      color: white;
      border: none;
      padding: 8px 25px;
      border-radius: 50px;
      transition: all 0.3s ease;
    }
    
    .btn-category:hover {
      background: var(--dark-color);
      transform: scale(1.05);
    }
    
    .no-image-placeholder {
      color: #6c757d;
      font-size: 0.9rem;
    }
  </style>
{% endblock %}

{% block body %}
<div class="categories-container">
  <div class="container">
    <h1 class="text-center mb-5">Nos Catégories</h1>
    
    <div class="row g-4">
      {% for categorie in categories %}
      <div class="col-md-4">
        <div class="category-card">
          <div class="category-img-container">
            {% if categorie.image %}
              <img src="{{ asset('images/categories/' ~ categorie.image) }}" 
                   class="category-img" 
                   alt="{{ categorie.nom }}"
                   onerror="this.style.display='none'; document.getElementById('missing-image-{{ categorie.id }}').style.display='block'">
              <div id="missing-image-{{ categorie.id }}" 
                   class="no-image-placeholder" 
                   style="display: none;">
                Image manquante
              </div>
            {% else %}
              <div class="no-image-placeholder">
                Aucune image définie
              </div>
            {% endif %}
          </div>
          <div class="category-body">
            <h3 class="text-center mb-3">{{ categorie.nom }}</h3>
            <a href="{{ path('app_produits_par_categorie', {'id': categorie.id}) }}" 
               class="btn btn-category mt-3">
              <i class="fas fa-utensils me-2"></i> Voir les produits
            </a>
          </div>
        </div>
      </div>
      {% else %}
      <div class="col-12">
        <div class="alert alert-info">Aucune catégorie disponible</div>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
{% endblock %}